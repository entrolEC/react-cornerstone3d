{
  "name": "react-cornerstone3d",
  "version": "0.5.0",
  "description": "React bindings that expose Cornerstone3D's live engine state to React, tearing-free, via useSyncExternalStore",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "default": "./dist/tools/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo": "vite demo",
    "demo:build": "vite build demo"
  },
  "peerDependencies": {
    "@cornerstonejs/core": "^5.0.0",
    "@cornerstonejs/tools": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@cornerstonejs/tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cornerstonejs/core": "^5.7.0",
    "@cornerstonejs/dicom-image-loader": "^5.10.7",
    "@cornerstonejs/tools": "^5.10.7",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser": "^3.2.7",
    "events": "^3.3.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.62.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.5.3",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/entrolEC/react-cornerstone3d.git"
  },
  "homepage": "https://github.com/entrolEC/react-cornerstone3d#readme",
  "keywords": [
    "cornerstone3d",
    "cornerstonejs",
    "react",
    "hooks",
    "useSyncExternalStore",
    "dicom",
    "medical-imaging"
  ],
  "sideEffects": false
}
